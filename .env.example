# ==============================================================================
# CinéCloud FR - Fichier de Configuration d'Environnement (.env)
# ==============================================================================
# Copiez ce fichier sous le nom .env pour personnaliser votre déploiement.
# CinéCloud fonctionne clé en main : les clés secrètes (.app_secret) et mots de
# passe administrateur (.admin_password) sont auto-générés de manière sécurisée
# dans le dossier data/ s'ils ne sont pas définis ci-dessous.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVEUR ET RÉSEAU
# ------------------------------------------------------------------------------
# Environnement d'exécution (production, development, test)
NODE_ENV=production

# Port d'écoute du serveur HTTP (1 à 65535, défaut: 3000)
PORT=3000

# Origines CORS supplémentaires autorisées pour les requêtes /api (séparées par des virgules).
# Ex: http://localhost:5173,https://admin.mondomaine.fr
CORS_ALLOWED_ORIGINS=

# Confiance accordée aux en-têtes X-Forwarded-* ('true', 'false' ou un entier >= 0).
# Défaut: false (sûr) — req.ip = adresse socket réelle, non falsifiable.
# Derrière Cloudflare Tunnel / Nginx / Caddy, définissez TRUST_PROXY=1 pour restaurer
# un rate-limiting par IP client. N'activez jamais si l'app est exposée directement.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. SÉCURITÉ & AUTHENTIFICATION
# ------------------------------------------------------------------------------
# Clé secrète de chiffrement AES-256-GCM (utilisée pour chiffrer les clés API
# des utilisateurs stockées dans SQLite nuvio.db).
# Si non définie, une clé cryptographiquement sûre de 32 octets (64 hex) est
# automatiquement générée et persistée dans data/.app_secret avec permissions 0600.
# APP_SECRET=votre_cle_secrete_aleatoire_de_minimum_16_caracteres

# Mot de passe d'accès au panneau d'administration (/admin).
# Si non défini, un mot de passe fort de 32 caractères est généré au premier
# démarrage et persisté dans data/.admin_password avec permissions 0600.
# Ne jamais utiliser "admin123" en production !
# ADMIN_PASSWORD=votre_mot_de_passe_admin_robuste_et_securise

# ------------------------------------------------------------------------------
# 3. CONTOURNEMENT VPS / PROXY WARP (ALLDEBRID + TORRENTIO)
# ------------------------------------------------------------------------------
# URL du proxy Cloudflare WARP ou proxy résidentiel permettant de contourner
# le blocage des adresses IP de datacenters / VPS imposé par AllDebrid.
# Utilisé aussi pour les requêtes Torrentio (Cloudflare renvoie un 403 aux IP de serveur),
# avec repli automatique en accès direct si le proxy est injoignable.
# Supporte HTTP (http://warp:1080), SOCKS5 (socks5://warp:1080) et SOCKS5h (socks5h://warp:1080).
# Laissez vide si vous hébergez CinéCloud sur une connexion résidentielle (box internet).
WARP_PROXY=http://warp:1080

# Proxies de sortie HTTP/HTTPS standards optionnels (repli si WARP_PROXY n'est pas utilisé)
# HTTP_PROXY=
# HTTPS_PROXY=

# ------------------------------------------------------------------------------
# 4. PROWLARR (INDEXEURS DE TORRENTS & SYNCHRONISATION RSS)
# ------------------------------------------------------------------------------
# URL de l'instance Prowlarr pour la recherche et la synchronisation de torrents.
# En Docker Compose avec réseau partagé : http://prowlarr:9696
# Si Prowlarr tourne sur l'hôte : http://host.docker.internal:9696
PROWLARR_URL=http://prowlarr:9696

# Clé API Prowlarr globale du serveur (Settings -> General -> API Key).
# Si omise ou "off", le serveur n'effectuera pas de synchronisation globale RSS,
# mais les utilisateurs pourront configurer leur propre clé via l'interface web.
PROWLARR_KEY=

# ------------------------------------------------------------------------------
# 5. DÉBRIDEURS & SERVICES EXTERNES GLOBAUX (OPTIONNEL)
# ------------------------------------------------------------------------------
# Clé API AllDebrid globale optionnelle (pour le nettoyage automatique des magnets
# bloqués ou pour des services partagés).
ALLDEBRID_API_KEY=

# Clé API Torbox globale optionnelle (Bearer token).
TORBOX_API_KEY=

# Clé API TheMovieDatabase (TMDB) optionnelle pour enrichir les métadonnées et affiches.
# Si omise, un fallback public fiable et gratuit est automatiquement utilisé.
TMDB_API_KEY=
